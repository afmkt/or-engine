# or-engine configuration ----------------------------------------------------
# Loaded by pydantic-settings as or_engine.config.Settings; field names map to
# UPPER_SNAKE env vars. Copy to `.env` and fill in.

# AMap (高德地图) Web Service API key (geocoding + direction / travel time).
# Leave empty to run with pre-set coordinates (Euclidean matrix, no geocoding).
AMAP_API_KEY=

# Postgres + PostGIS. Leave empty to run in pure in-memory mode (Euclidean
# travel matrix, no DB) — handy for local testing.
DATABASE_URL=postgresql://or_engine:or_engine@localhost:5432/or_engine

# REST listen address.
HOST=0.0.0.0
PORT=8000

# Solver time limit (seconds).
SOLVER_TIMEOUT_S=30

# Per-transport speed factor (multiplier on AMap *driving* durations): JSON
# dict. e-bike / out-of-town cars are slower than an ordinary SH-plate car.
TRANSPORT_SPEED_FACTORS={"ebike": 1.6, "car_sh": 1.0, "car_out": 1.15}
